generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ContentType {
  BOOK
  MOVIE
  ESSAY
  INTERVIEW
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  title              String   @default("Topluluk Yönetim Kurulu Üyesi")
  role               Role     @default(EDITOR)
  password           String?
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  date        DateTime
  location    String?
  imageUrl    String?
  formUrl     String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Content {
  id          String      @id @default(cuid())
  title       String
  summary     String?
  content     String      @db.Text
  type        ContentType
  author      String?
  imageUrl    String?
  isPublished Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Dictionary {
  id         String   @id @default(cuid())
  term       String
  definition String   @db.Text
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ColumnArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  body        String   @db.Text
  authorName  String
  authorRole  String?
  authorImage String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

